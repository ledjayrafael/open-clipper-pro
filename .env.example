# Copy to .env and fill in. .env is gitignored; never commit real keys.
OPENROUTER_API_KEY=sk-or-...
GROQ_API_KEY=gsk_...
# Optional
# OPENROUTER_MODEL=google/gemini-3.1-flash-lite-preview
# CLIPPER_SERVER_PORT=3030
# Python used for face tracking (needs server/requirements.txt), e.g. .venv/bin/python
# PYTHON_BIN=python
# Audio language for Whisper (default id). Leave empty for auto-detect.
# WHISPER_LANGUAGE=id
# AI mode: openrouter (cloud), ollama (local) or custom. Can also be switched in the UI.
# AI_PROVIDER=openrouter
# Custom provider: any OpenAI-compatible API (OpenAI, Gemini, Groq, LM Studio, vLLM, ...)
# CUSTOM_AI_BASE_URL=https://api.openai.com/v1
# CUSTOM_AI_MODEL=gpt-5-mini
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_NAME=OpenAI
# CUSTOM_AI_MAX_TOKENS=16000
# Video encoder: cpu (default), auto (use a working GPU encoder), or e.g. h264_nvenc
# VIDEO_ENCODER=cpu
# Kill an FFmpeg encode that makes no progress for this many seconds
# FFMPEG_STALL_SECONDS=120
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
