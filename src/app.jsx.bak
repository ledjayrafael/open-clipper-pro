import React, { useState, useEffect, useRef } from 'react';
import { 
  UploadCloud, 
  FileVideo, 
  Sparkles, 
  Crop, 
  Download, 
  Play, 
  CheckCircle2, 
  Loader2,
  Maximize2,
  User,
  Cpu,
  ShieldCheck,
  Zap,
  Trash2,
  Settings
} from 'lucide-react';

/**
 * Komponen Utama App
 * Aplikasi ini menggabungkan semua logika pemrosesan lokal dalam satu file
 * untuk memastikan kompatibilitas dan kemudahan penggunaan.
 */
export default function App() {
  const [videoFile, setVideoFile] = useState(null);
  const [videoSrc, setVideoSrc] = useState(null);
  const [language, setLanguage] = useState('id');
  const [status, setStatus] = useState('idle'); // idle, loading-lib, analyzing, ready, processing, completed
  const [moments, setMoments] = useState([]);
  const [selectedMoment, setSelectedMoment] = useState(null);
  const [progress, setProgress] = useState({ value: 0, label: '' });
  const videoRef = useRef(null);
  
  // Inisialisasi library (Simulasi pemuatan WASM)
  useEffect(() => {
    const initClientLibraries = async () => {
      setStatus('loading-lib');
      setProgress({ value: 20, label: 'Menginisialisasi WebAssembly Core...' });
      await new Promise(r => setTimeout(r, 600));
      setProgress({ value: 60, label: 'Memuat Model Deteksi Wajah (MediaPipe)...' });
      await new Promise(r => setTimeout(r, 500));
      setStatus('idle');
    };
    initClientLibraries();
  }, []);

  // Handler untuk mengunggah video lokal
  const handleFileChange = (e) => {
    const file = e.target.files[0];
    if (file && file.type.startsWith('video/')) {
      // Membersihkan URL lama jika ada untuk mencegah kebocoran memori
      if (videoSrc) URL.revokeObjectURL(videoSrc);
      
      setVideoFile(file);
      setVideoSrc(URL.createObjectURL(file));
      setMoments([]);
      setSelectedMoment(null);
      setStatus('idle');
    }
  };

  const removeFile = () => {
    if (videoSrc) URL.revokeObjectURL(videoSrc);
    setVideoFile(null);
    setVideoSrc(null);
    setMoments([]);
    setSelectedMoment(null);
    setStatus('idle');
  };

  // Simulasi analisis momen viral secara lokal
  const handleAnalyze = async () => {
    setStatus('analyzing');
    setProgress({ value: 10, label: 'Memindai frame video menggunakan AI lokal...' });
    
    // Di sini Anda nantinya akan menghubungkan MediaPipe atau model Transformers.js
    setTimeout(() => {
      const results = [
        { id: 1, start: "00:15", end: "00:45", score: 98, reason: "Punchline & lonjakan audio terdeteksi", title: "Momen Viral Utama" },
        { id: 2, start: "01:20", end: "01:55", score: 85, reason: "Transisi visual yang dinamis", title: "Segmen Hook" },
        { id: 3, start: "03:10", end: "03:40", score: 72, reason: "Informasi teknis penting", title: "Key Insight" },
      ];
      setMoments(results);
      setSelectedMoment(results[0]);
      setStatus('ready');
    }, 2000);
  };

  // Simulasi ekspor menggunakan FFmpeg.wasm
  const handleExport = async () => {
    setStatus('processing');
    let p = 0;
    const interval = setInterval(() => {
      p += 4;
      let label = 'FFmpeg: Melakukan cropping vertikal...';
      if (p > 50) label = 'MediaPipe: Mengunci posisi wajah di tengah...';
      if (p > 85) label = 'Menyusun file MP4 akhir...';
      
      setProgress({ value: p, label });
      
      if (p >= 100) {
        clearInterval(interval);
        setStatus('completed');
      }
    }, 150);
  };

  return (
    <div className="min-h-screen bg-[#020202] text-slate-100 font-sans p-4 md:p-8 selection:bg-indigo-500/30">
      {/* Badge Informasi Pemrosesan Lokal */}
      <div className="max-w-6xl mx-auto mb-8 flex flex-wrap items-center justify-between gap-4 px-6 py-3 bg-indigo-500/5 border border-indigo-500/10 rounded-2xl text-[10px] font-bold tracking-widest text-indigo-400">
        <div className="flex items-center gap-2">
          <ShieldCheck className="w-4 h-4" />
          <span>PEMROSESAN LOKAL AKTIF: VIDEO TIDAK DIUNGGAH KE SERVER</span>
        </div>
        <div className="flex items-center gap-6">
          <span className="flex items-center gap-1.5"><Cpu className="w-3.5 h-3.5" /> WASM ENGINE v1.2</span>
          <span className="flex items-center gap-1.5"><Zap className="w-3.5 h-3.5" /> WEBGL READY</span>
        </div>
      </div>

      <header className="max-w-6xl mx-auto mb-12 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h1 className="text-5xl font-black bg-gradient-to-r from-white via-indigo-200 to-slate-400 bg-clip-text text-transparent italic tracking-tighter">
            CLIPPER.PRO
          </h1>
          <p className="text-slate-500 mt-2 font-medium text-base">Ubah video horizontal menjadi konten viral vertikal dalam hitungan detik.</p>
        </div>
        
        <div className="flex items-center gap-3">
          <label className="text-[10px] font-bold text-slate-600 uppercase tracking-widest mr-2">Target Bahasa</label>
          <select 
            value={language}
            onChange={(e) => setLanguage(e.target.value)}
            className="bg-slate-900 border border-slate-800 rounded-xl px-5 py-2.5 text-xs font-bold focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all cursor-pointer hover:border-slate-700"
          >
            <option value="id">INDONESIA (LOKAL)</option>
            <option value="en">ENGLISH (AUTO)</option>
          </select>
        </div>
      </header>

      {status === 'loading-lib' ? (
        <div className="max-w-md mx-auto mt-40 text-center">
          <div className="relative inline-block mb-6">
            <Loader2 className="w-12 h-12 animate-spin text-indigo-500" />
            <div className="absolute inset-0 bg-indigo-500/20 blur-xl rounded-full"></div>
          </div>
          <h3 className="text-xl font-bold mb-2 tracking-tight">Menyiapkan Browser Engine</h3>
          <p className="text-slate-500 text-sm font-mono lowercase tracking-wide">{progress.label}</p>
          <div className="mt-8 w-full bg-slate-900 h-1.5 rounded-full overflow-hidden">
            <div className="bg-indigo-500 h-full transition-all duration-500" style={{ width: `${progress.value}%` }}></div>
          </div>
        </div>
      ) : (
        <main className="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          
          {/* Sisi Kiri: Upload & Dashboard Kontrol */}
          <div className="lg:col-span-5 space-y-8">
            <section className="bg-[#080808] border border-slate-800/60 rounded-[2.5rem] p-10 shadow-2xl">
              {!videoFile ? (
                <div className="border-2 border-dashed border-slate-800/50 rounded-3xl p-12 text-center hover:border-indigo-500/40 transition-all group cursor-pointer relative bg-black/40">
                  <input 
                    type="file" 
                    accept="video/*" 
                    className="absolute inset-0 opacity-0 cursor-pointer z-10" 
                    onChange={handleFileChange}
                  />
                  <div className="w-20 h-20 bg-indigo-500/5 rounded-[2rem] flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform group-hover:bg-indigo-500/10">
                    <UploadCloud className="text-slate-600 group-hover:text-indigo-400 w-8 h-8 transition-colors" />
                  </div>
                  <h3 className="text-xl font-bold mb-2">Pilih Video</h3>
                  <p className="text-slate-500 text-sm leading-relaxed">Klik atau tarik file video MP4/MOV ke sini untuk memulai pemrosesan lokal.</p>
                </div>
              ) : (
                <div className="space-y-6">
                  <div className="flex items-center justify-between p-5 bg-black border border-slate-800 rounded-3xl group">
                    <div className="flex items-center gap-5">
                      <div className="p-4 bg-indigo-500/10 rounded-2xl group-hover:scale-105 transition-transform">
                        <FileVideo className="text-indigo-400 w-6 h-6" />
                      </div>
                      <div className="overflow-hidden">
                        <p className="font-bold text-sm truncate w-32 md:w-48 text-slate-200">{videoFile.name}</p>
                        <p className="text-[10px] text-slate-600 font-bold uppercase mt-0.5 tracking-wider">
                          {(videoFile.size / (1024 * 1024)).toFixed(1)} MB • LOCAL STORAGE
                        </p>
                      </div>
                    </div>
                    <button onClick={removeFile} className="p-3 hover:bg-red-500/10 text-slate-700 hover:text-red-500 transition-all rounded-xl">
                      <Trash2 size={20} />
                    </button>
                  </div>
                  <button 
                    onClick={handleAnalyze}
                    disabled={status === 'analyzing'}
                    className="w-full bg-indigo-600 hover:bg-indigo-500 text-white disabled:opacity-30 py-5 rounded-3xl font-black transition-all flex items-center justify-center gap-3 uppercase text-xs tracking-[0.2em] shadow-xl shadow-indigo-600/20 active:scale-[0.97]"
                  >
                    {status === 'analyzing' ? <Loader2 className="animate-spin" size={20} /> : <Sparkles size={20} />}
                    Mulai Deteksi AI
                  </button>
                </div>
              )}
            </section>

            {/* Momen Hasil Analisis */}
            {moments.length > 0 && (
              <section className="space-y-5 animate-in fade-in slide-in-from-bottom-6 duration-700">
                <div className="flex items-center justify-between px-2">
                  <h2 className="text-[10px] font-black text-slate-600 uppercase tracking-[0.3em]">Viral Highlights</h2>
                  <Settings className="w-3.5 h-3.5 text-slate-800 cursor-pointer hover:text-slate-400" />
                </div>
                <div className="space-y-4">
                  {moments.map((m) => (
                    <button
                      key={m.id}
                      onClick={() => setSelectedMoment(m)}
                      className={`w-full text-left p-6 rounded-3xl border transition-all duration-500 ${
                        selectedMoment?.id === m.id 
                        ? 'bg-indigo-600 border-indigo-400 shadow-2xl shadow-indigo-600/40 scale-[1.03] translate-x-1' 
                        : 'bg-[#080808] border-slate-800/60 hover:border-slate-600'
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <div className="flex gap-5">
                          <span className={`text-2xl font-black italic ${selectedMoment?.id === m.id ? 'text-indigo-200' : 'text-slate-800'}`}>
                            {m.id}
                          </span>
                          <div>
                            <p className="font-bold text-sm tracking-tight">{m.title}</p>
                            <p className={`text-[10px] font-bold mt-1.5 flex items-center gap-2 ${selectedMoment?.id === m.id ? 'text-indigo-200/80' : 'text-slate-500'}`}>
                              <span className="opacity-60">{m.start} - {m.end}</span>
                              <span className="w-1 h-1 rounded-full bg-current opacity-30"></span>
                              <span>{m.reason}</span>
                            </p>
                          </div>
                        </div>
                        <div className={`text-[10px] font-black px-3 py-1.5 rounded-full border ${selectedMoment?.id === m.id ? 'bg-white/10 border-white/20 text-white' : 'bg-black border-slate-800 text-indigo-500'}`}>
                          {m.score}%
                        </div>
                      </div>
                    </button>
                  ))}
                </div>
              </section>
            )}
          </div>

          {/* Sisi Kanan: Live Preview & Export */}
          <div className="lg:col-span-7">
            <section className="bg-[#080808] border border-slate-800/60 rounded-[3rem] p-10 lg:sticky lg:top-8 shadow-2xl">
              <div className="flex items-center justify-between mb-10">
                <div className="flex items-center gap-4">
                  <div className="p-3 bg-indigo-500/5 border border-indigo-500/10 rounded-2xl">
                    <Maximize2 className="text-indigo-400 w-6 h-6" />
                  </div>
                  <div>
                    <h2 className="font-black text-sm uppercase tracking-widest text-slate-200">9:16 Preview Render</h2>
                    <p className="text-[9px] text-slate-600 font-mono mt-0.5">Hardware Acceleration: WebGL Core</p>
                  </div>
                </div>
                {status === 'ready' && (
                  <div className="flex items-center gap-2.5 text-[10px] bg-green-500/5 text-green-400 px-4 py-2 rounded-full border border-green-500/20 font-black animate-in fade-in zoom-in-95 tracking-tight">
                    <div className="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></div>
                    WAJAH TERDETEKSI
                  </div>
                )}
              </div>

              {/* Area Canvas Video */}
              <div className="aspect-video bg-black rounded-[2rem] overflow-hidden relative border border-slate-900/50 shadow-inner flex items-center justify-center group">
                {!videoSrc ? (
                  <div className="text-center opacity-40 group-hover:opacity-60 transition-opacity">
                    <div className="w-16 h-16 bg-slate-900/50 rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-800/50 shadow-lg">
                      <Play className="text-slate-700 fill-slate-700 ml-1.5 w-6 h-6" />
                    </div>
                    <p className="text-slate-600 text-[10px] font-black uppercase tracking-[0.3em]">Menunggu Unggahan Video</p>
                  </div>
                ) : (
                  <div className="relative w-full h-full flex items-center justify-center">
                    {/* Background Blur untuk kedalaman visual */}
                    <video src={videoSrc} className="absolute inset-0 w-full h-full object-cover opacity-10 blur-3xl scale-110" muted loop autoPlay />
                    
                    {/* Jendela Crop Vertikal */}
                    <div className="h-[95%] aspect-[9/16] bg-[#020202] rounded-3xl border border-white/5 relative shadow-[0_0_50px_rgba(0,0,0,0.8)] overflow-hidden z-10 group">
                       <video 
                        src={videoSrc}
                        className="absolute inset-0 h-full w-auto max-w-none left-1/2 -translate-x-1/2 object-cover opacity-90"
                        muted loop autoPlay
                       />
                       
                       {/* Overlay Tracking UI */}
                       <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-44 h-44 border border-indigo-500/20 rounded-full z-20 pointer-events-none">
                          <div className="absolute inset-0 border-t-2 border-indigo-400/60 w-8 h-8 -top-1 -left-1 rounded-tl-2xl"></div>
                          <div className="absolute inset-0 border-t-2 border-indigo-400/60 w-8 h-8 -top-1 -right-1 rounded-tr-2xl ml-auto"></div>
                          <div className="absolute inset-0 border-b-2 border-indigo-400/60 w-8 h-8 -bottom-1 -left-1 rounded-bl-2xl mt-auto"></div>
                          <div className="absolute inset-0 border-b-2 border-indigo-400/60 w-8 h-8 -bottom-1 -right-1 rounded-br-2xl mt-auto ml-auto"></div>
                       </div>

                       {/* Subtitle Mockup */}
                       <div className="absolute bottom-12 left-4 right-4 text-center z-30">
                          <p className="bg-black/80 backdrop-blur-xl px-5 py-3 rounded-2xl text-[10px] font-black border border-white/10 inline-block uppercase tracking-tight shadow-2xl leading-tight">
                            {language === 'id' ? '✨ "Ini adalah cuplikan video viral Anda!"' : '✨ "This is your viral video snippet!"'}
                          </p>
                       </div>
                    </div>
                  </div>
                )}
              </div>

              {/* Status Pemrosesan & Aksi Akhir */}
              <div className="mt-12 space-y-8">
                {status === 'processing' && (
                  <div className="p-6 bg-black border border-slate-800 rounded-[2rem] shadow-inner animate-in fade-in zoom-in-95">
                    <div className="flex justify-between text-[10px] font-black uppercase mb-4 tracking-widest text-slate-500">
                      <span className="italic">{progress.label}</span>
                      <span className="text-indigo-400 bg-indigo-400/5 px-3 py-1 rounded-full">{progress.value}%</span>
                    </div>
                    <div className="w-full bg-slate-900/50 h-2 rounded-full overflow-hidden">
                      <div 
                        className="bg-indigo-500 h-full transition-all duration-300 shadow-[0_0_20px_rgba(99,102,241,0.4)]"
                        style={{ width: `${progress.value}%` }}
                      ></div>
                    </div>
                  </div>
                )}

                {status === 'completed' && (
                  <div className="p-6 bg-green-500/5 border border-green-500/10 rounded-[2rem] flex items-center justify-between shadow-2xl animate-in slide-in-from-top-4 duration-500">
                    <div className="flex items-center gap-5">
                      <div className="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center shadow-lg shadow-green-500/20">
                        <CheckCircle2 className="text-white w-7 h-7" />
                      </div>
                      <div>
                        <p className="font-black text-sm text-white uppercase tracking-widest">Siap Diunduh</p>
                        <p className="text-[9px] text-green-500/60 font-mono tracking-tighter mt-0.5">vertical_clip_ready.mp4 // 1080x1920</p>
                      </div>
                    </div>
                    <button className="bg-white text-black px-8 py-3.5 rounded-2xl text-[10px] font-black uppercase hover:bg-slate-200 transition-all shadow-xl active:scale-95 tracking-widest">
                      Simpan Ke PC
                    </button>
                  </div>
                )}

                <div className="grid grid-cols-2 gap-5">
                  <button 
                    disabled={!selectedMoment || status === 'processing'} 
                    className="bg-transparent border border-slate-800 hover:border-slate-600 hover:bg-white/5 py-5 rounded-3xl text-[10px] font-black uppercase tracking-[0.2em] transition-all disabled:opacity-20 active:scale-[0.98]"
                  >
                    Atur Crop
                  </button>
                  <button 
                    onClick={handleExport}
                    disabled={!selectedMoment || status === 'processing' || status === 'completed'}
                    className="bg-indigo-600 hover:bg-indigo-500 disabled:opacity-20 py-5 rounded-3xl text-[10px] font-black uppercase tracking-[0.2em] shadow-2xl shadow-indigo-600/30 transition-all flex items-center justify-center gap-3 active:scale-[0.98]"
                  >
                    <Download size={16} />
                    Export Video
                  </button>
                </div>
              </div>
            </section>
          </div>
        </main>
      )}

      {/* Footer Branding */}
      <footer className="max-w-6xl mx-auto mt-24 pb-16 border-t border-slate-900/50 pt-16 flex flex-col md:flex-row items-center justify-between opacity-20 text-[9px] font-black uppercase tracking-[0.4em] text-slate-500">
        <p>CLIPPER.PRO ENGINE v4.0.2-WASM-LOCAL</p>
        <div className="flex gap-10 mt-8 md:mt-0">
          <span className="hover:text-white transition-colors cursor-help">No Cloud Storage</span>
          <span className="hover:text-white transition-colors cursor-help">GPU Accelerated</span>
          <span className="hover:text-white transition-colors cursor-help">Open Engine</span>
        </div>
      </footer>
    </div>
  );
}