import React, { useState, useEffect, useRef } from 'react';
import { 
  UploadCloud, FileVideo, Sparkles, Download, Play, Pause,
  CheckCircle2, Loader2, Maximize2, Cpu, 
  ShieldCheck, Zap, Trash2, Settings, RefreshCw
} from 'lucide-react';

/**
 * Clipper Pro App - Ultra Stable Build
 * Memperbaiki masalah Blank Screen, Tombol Export, dan Subtitle.
 */

// Konfigurasi OpenRouter - Masukkan API Key Anda dari openrouter.ai di sini
const openRouterApiKey = "REMOVED_OPENROUTER_KEY"; 

export default function App() {
  const [videoFile, setVideoFile] = useState(null);
  const [videoSrc, setVideoSrc] = useState(null);
  const [status, setStatus] = useState('idle'); // idle, loading-lib, analyzing, ready, processing, completed
  const [moments, setMoments] = useState([]);
  const [selectedMoment, setSelectedMoment] = useState(null);
  const [progress, setProgress] = useState({ value: 0, label: '' });
  const [currentTime, setCurrentTime] = useState(0);
  const [ffmpegLoaded, setFfmpegLoaded] = useState(false);
  const [isPlaying, setIsPlaying] = useState(false);
  
  const ffmpegRef = useRef(null);
  const videoRef = useRef(null);

  /**
   * 1. Inisialisasi Engine Video (FFmpeg)
   * Menggunakan pendekatan sinkronisasi skrip yang lebih aman.
   */
  useEffect(() => {
    const initFFmpeg = async () => {
      try {
        setStatus('loading-lib');
        setProgress({ value: 10, label: 'Initializing video engine...' });

        const loadScript = (src, id) => {
          return new Promise((resolve) => {
            if (document.getElementById(id)) return resolve();
            const script = document.createElement('script');
            script.src = src;
            script.id = id;
            script.async = true;
            script.onload = () => resolve();
            document.head.appendChild(script);
          });
        };

        // Muat library secara berurutan
        await loadScript('https://unpkg.com/@ffmpeg/ffmpeg@0.12.7/dist/umd/ffmpeg.js', 'ffmpeg-core-js');
        await loadScript('https://unpkg.com/@ffmpeg/util@0.12.1/dist/umd/index.js', 'ffmpeg-util-js');

        // Tunggu sejenak agar objek window benar-benar terisi
        await new Promise(r => setTimeout(r, 1000));

        const FFmpegNamespace = window.FFmpegWasm || window.FFmpeg;
        if (!FFmpegNamespace || !FFmpegNamespace.FFmpeg) {
          throw new Error("FFmpeg not found on window object.");
        }

        const ffmpeg = new FFmpegNamespace.FFmpeg();
        ffmpegRef.current = ffmpeg;

        const baseURL = 'https://unpkg.com/@ffmpeg/core@0.12.6/dist/esm';
        const util = window.FFmpegUtil;
        
        if (!util || !util.toBlobURL) throw new Error("FFmpegUtil missing.");

        setProgress({ value: 40, label: 'Loading WASM core...' });
        
        await ffmpeg.load({
          coreURL: await util.toBlobURL(`${baseURL}/ffmpeg-core.js`, 'text/javascript'),
          wasmURL: await util.toBlobURL(`${baseURL}/ffmpeg-core.wasm`, 'application/wasm'),
        });

        console.log("FFmpeg Ready!");
        setFfmpegLoaded(true);
        setStatus('idle');
      } catch (err) {
        console.error("Critical Engine Error:", err);
        setProgress({ value: 0, label: `Engine Error: ${err.message}` });
        setStatus('idle');
      }
    };

    initFFmpeg();
  }, []);

  /**
   * 2. Sinkronisasi Video & Subtitle
   */
  useEffect(() => {
    const video = videoRef.current;
    if (!video) return;

    const onTimeUpdate = () => setCurrentTime(video.currentTime);
    const onPlay = () => setIsPlaying(true);
    const onPause = () => setIsPlaying(false);

    video.addEventListener('timeupdate', onTimeUpdate);
    video.addEventListener('play', onPlay);
    video.addEventListener('pause', onPause);

    return () => {
      video.removeEventListener('timeupdate', onTimeUpdate);
      video.removeEventListener('play', onPlay);
      video.removeEventListener('pause', onPause);
    };
  }, [videoSrc]);

  const handleTogglePlay = (e) => {
    if (e) e.preventDefault();
    if (!videoRef.current) return;
    if (videoRef.current.paused) {
      videoRef.current.play().catch(console.error);
    } else {
      videoRef.current.pause();
    }
  };

  /**
   * 3. Analisis AI OpenRouter
   */
  const startAnalysis = async () => {
    if (!videoFile || !openRouterApiKey) {
      alert("Please upload a video and insert your API Key.");
      return;
    }
    
    setStatus('analyzing');
    setProgress({ value: 50, label: 'AI is analyzing moments...' });
    
    try {
      const prompt = `You are a viral video specialist. Find 5 segments (start, end in seconds). You MUST return pure JSON: {"moments": [{"id":1, "start":10, "end":25, "title":"Epic Moment", "reason":"High Energy", "score":98, "subtitle":"UNBELIEVABLE!"}]}`;
      
      const response = await fetch("https://openrouter.ai/api/v1/chat/completions", {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${openRouterApiKey}`,
        },
        body: JSON.stringify({
          model: "openai/gpt-4o-mini",
          messages: [
            { role: "system", content: prompt },
            { role: "user", content: `Analyze video: ${videoFile.name}, size: ${videoFile.size} bytes` }
          ],
          response_format: { type: "json_object" }
        })
      });

      if (!response.ok) throw new Error("API call failed");
      const result = await response.json();
      const content = JSON.parse(result.choices[0].message.content);
      
      const formatted = content.moments.map(m => ({
        ...m,
        start: Number(m.start),
        end: Number(m.end),
        startTimeStr: new Date(m.start * 1000).toISOString().substr(14, 5),
        endTimeStr: new Date(m.end * 1000).toISOString().substr(14, 5)
      }));
      
      setMoments(formatted);
      setSelectedMoment(formatted[0]);
      setStatus('ready');
    } catch (err) {
      console.error(err);
      setStatus('idle');
      alert("Analysis failed: " + err.message);
    }
  };

  /**
   * 4. Ekspor FFmpeg
   */
  const runExport = async () => {
    if (!selectedMoment || !videoFile || !ffmpegLoaded) return;
    
    setStatus('processing');
    setProgress({ value: 10, label: 'Running local FFmpeg worker...' });

    try {
      const ffmpeg = ffmpegRef.current;
      const { fetchFile } = window.FFmpegUtil;
      
      await ffmpeg.writeFile('input.mp4', await fetchFile(videoFile));
      
      setProgress({ value: 40, label: 'Applying 9:16 Vertical Crop...' });
      await ffmpeg.exec([
        '-i', 'input.mp4',
        '-ss', selectedMoment.start.toString(),
        '-to', selectedMoment.end.toString(),
        '-vf', 'crop=ih*(9/16):ih:(iw-ow)/2:0',
        '-c:v', 'libx264',
        '-preset', 'ultrafast',
        '-c:a', 'copy',
        'output.mp4'
      ]);

      const data = await ffmpeg.readFile('output.mp4');
      const url = URL.createObjectURL(new Blob([data.buffer], { type: 'video/mp4' }));
      
      const a = document.createElement('a');
      a.href = url;
      a.download = `Vertical_Clip_${selectedMoment.id}.mp4`;
      a.click();

      setStatus('completed');
    } catch (err) {
      console.error("Export Error:", err);
      setStatus('ready');
      alert("Export failed: " + err.message);
    }
  };

  return (
    <div className="min-h-screen bg-[#050505] text-slate-100 font-sans selection:bg-indigo-500/30">
      {/* Engine Status Top Bar */}
      <div className="w-full bg-indigo-600/10 border-b border-indigo-500/10 px-6 py-2 flex justify-between items-center text-[10px] font-bold tracking-widest text-indigo-400 uppercase">
        <div className="flex items-center gap-2">
          <ShieldCheck size={14} className="shrink-0" /> SECURITY: ON-DEVICE
        </div>
        <div className="flex gap-6">
          <span className="flex items-center gap-1">
            <Cpu size={12} className={ffmpegLoaded ? "text-green-400" : "text-slate-500"} /> 
            CORE: {ffmpegLoaded ? "READY" : "LOADING..."}
          </span>
          <span className="flex items-center gap-1"><Zap size={12} className="text-yellow-400" /> GPU ACCELERATED</span>
        </div>
      </div>

      <div className="max-w-7xl mx-auto p-6 md:p-12">
        <header className="mb-12 text-left">
          <h1 className="text-5xl font-black italic tracking-tighter bg-gradient-to-r from-white to-slate-500 bg-clip-text text-transparent uppercase">
            Clipper.Pro
          </h1>
          <p className="text-slate-500 font-medium mt-1 uppercase tracking-widest text-[10px]">On-Device Vertical Automation Studio</p>
        </header>

        {status === 'loading-lib' ? (
          <div className="py-32 text-center">
            <Loader2 className="w-12 h-12 animate-spin mx-auto mb-6 text-indigo-500" />
            <p className="text-slate-400 font-mono text-[10px] uppercase tracking-widest font-bold">{progress.label}</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 text-left">
            
            {/* Column 1: Controls */}
            <div className="lg:col-span-5 space-y-8">
              <div className="bg-[#0A0A0A] border border-slate-800 rounded-[2.5rem] p-8 shadow-2xl">
                {!videoFile ? (
                  <div className="border-2 border-dashed border-slate-800 rounded-[2rem] p-12 text-center relative group bg-black/40 hover:border-indigo-500/50 transition-all cursor-pointer">
                    <input type="file" accept="video/*" className="absolute inset-0 opacity-0 cursor-pointer z-10" onChange={(e) => {
                      const file = e.target.files[0];
                      if (file) {
                        if (videoSrc) URL.revokeObjectURL(videoSrc);
                        setVideoFile(file);
                        setVideoSrc(URL.createObjectURL(file));
                        setMoments([]);
                        setSelectedMoment(null);
                        setStatus('idle');
                      }
                    }} />
                    <UploadCloud className="mx-auto mb-4 text-slate-700 group-hover:text-indigo-400 transition-colors" size={48} />
                    <p className="text-sm font-black uppercase tracking-widest text-slate-300">Unggah Video</p>
                  </div>
                ) : (
                  <div className="space-y-6">
                    <div className="flex items-center justify-between p-5 bg-black border border-slate-800 rounded-2xl group">
                      <div className="flex items-center gap-4 overflow-hidden">
                        <FileVideo className="text-indigo-400 shrink-0" size={24} />
                        <div className="overflow-hidden">
                          <p className="text-xs font-black truncate text-slate-200 uppercase tracking-tight">{videoFile.name}</p>
                          <p className="text-[9px] text-slate-600 font-bold mt-1">{(videoFile.size / (1024 * 1024)).toFixed(1)} MB</p>
                        </div>
                      </div>
                      <button onClick={() => { setVideoFile(null); setVideoSrc(null); setMoments([]); }} className="text-slate-600 hover:text-red-500 p-2"><Trash2 size={20} /></button>
                    </div>
                    <button 
                      onClick={startAnalysis} 
                      disabled={status === 'analyzing'}
                      className="w-full bg-white text-black font-black py-5 rounded-2xl text-[10px] uppercase tracking-[0.2em] hover:bg-indigo-50 transition-all flex items-center justify-center gap-3 shadow-xl active:scale-95 disabled:opacity-30"
                    >
                      {status === 'analyzing' ? <Loader2 className="animate-spin" /> : <Sparkles size={18} />}
                      AI DETECT MOMENTS
                    </button>
                  </div>
                )}
              </div>

              {moments.length > 0 && (
                <div className="space-y-4 animate-in fade-in slide-in-from-bottom-6">
                  <h2 className="text-[10px] font-black text-slate-600 uppercase tracking-[0.3em] px-4 italic underline decoration-indigo-500">Momen Terdeteksi</h2>
                  <div className="space-y-3">
                    {moments.map(m => (
                      <button 
                        key={m.id} 
                        onClick={() => {
                          setSelectedMoment(m);
                          if(videoRef.current) {
                            videoRef.current.currentTime = m.start;
                            videoRef.current.play().catch(() => {});
                          }
                        }}
                        className={`w-full p-6 rounded-[2rem] border text-left transition-all duration-300 group ${
                          selectedMoment?.id === m.id 
                          ? 'bg-indigo-600 border-indigo-400 shadow-2xl scale-[1.02]' 
                          : 'bg-[#0A0A0A] border-slate-800 hover:border-slate-700'
                        }`}
                      >
                        <div className="flex justify-between items-center mb-1">
                          <span className={`font-black text-sm uppercase ${selectedMoment?.id === m.id ? 'text-white' : 'text-slate-200'}`}>{m.title}</span>
                          <span className={`text-[9px] font-black px-2 py-0.5 rounded ${selectedMoment?.id === m.id ? 'bg-white/20' : 'bg-black text-indigo-500'}`}>{m.score}%</span>
                        </div>
                        <p className={`text-[10px] font-bold ${selectedMoment?.id === m.id ? 'text-indigo-200' : 'text-slate-600'}`}>
                          {m.startTimeStr} - {m.endTimeStr} • {m.reason}
                        </p>
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {/* Column 2: Player & Render */}
            <div className="lg:col-span-7">
              <div className="bg-[#0A0A0A] border border-slate-800 rounded-[3rem] p-10 shadow-2xl lg:sticky lg:top-8 text-left">
                <div className="flex items-center gap-3 mb-10">
                  <Maximize2 size={20} className="text-indigo-400" />
                  <div>
                    <h2 className="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 leading-none">Vertical Preview</h2>
                    <p className="text-[9px] text-slate-600 font-mono mt-1 italic uppercase">9:16 Local Render</p>
                  </div>
                </div>

                {/* Player Container */}
                <div 
                  className="aspect-video bg-black rounded-[2.5rem] border border-slate-900 flex items-center justify-center overflow-hidden relative shadow-inner group"
                >
                  {!videoSrc ? (
                    <div className="text-center opacity-10">
                      <Play size={64} className="mx-auto mb-4" />
                    </div>
                  ) : (
                    <div className="relative h-full aspect-[9/16] bg-black shadow-2xl overflow-hidden border border-white/5 ring-1 ring-white/10 transition-all duration-700">
                      <video src={videoSrc} className="absolute inset-0 h-full w-full object-cover opacity-20 blur-3xl scale-125" muted loop autoPlay />
                      <video 
                        ref={videoRef}
                        src={videoSrc} 
                        className="relative h-full w-auto max-w-none left-1/2 -translate-x-1/2 object-cover shadow-2xl z-10" 
                      />
                      
                      {/* Subtitle Logic */}
                      {selectedMoment && currentTime >= selectedMoment.start && currentTime <= selectedMoment.end && (
                        <div className="absolute bottom-16 left-4 right-4 z-40 text-center pointer-events-none animate-in fade-in slide-in-from-bottom-2 duration-300">
                          <span className="bg-yellow-400 text-black font-black text-[14px] px-5 py-2.5 rounded-lg uppercase shadow-[0_20px_50px_rgba(0,0,0,0.9)] border-2 border-black inline-block leading-tight scale-110">
                            {selectedMoment.subtitle || "VIRAL HIGHLIGHT!"}
                          </span>
                        </div>
                      )}

                      {/* Custom UI Player Button Overlay */}
                      <div 
                        className={`absolute inset-0 z-30 flex items-center justify-center transition-opacity duration-300 cursor-pointer ${isPlaying ? 'opacity-0 hover:opacity-100' : 'opacity-100 bg-black/30'}`}
                        onClick={handleTogglePlay}
                      >
                         <div className="bg-white/10 backdrop-blur-xl p-6 rounded-full border border-white/20 shadow-2xl hover:scale-110 transition-transform">
                            {isPlaying ? <Pause className="text-white fill-white" size={40} /> : <Play className="text-white fill-white ml-2" size={40} />}
                         </div>
                      </div>
                    </div>
                  )}
                </div>

                <div className="mt-12 space-y-8">
                  {/* Progress Section */}
                  {(status === 'processing' || status === 'analyzing') && (
                    <div className="p-6 bg-black border border-slate-800 rounded-3xl animate-in zoom-in-95">
                      <div className="flex justify-between text-[10px] font-black uppercase mb-4 tracking-widest text-left">
                        <span className="text-slate-600 italic uppercase font-bold">{progress.label}</span>
                        <span className="text-indigo-400 font-bold">{progress.value}%</span>
                      </div>
                      <div className="h-1.5 bg-slate-900 rounded-full overflow-hidden">
                        <div className="h-full bg-indigo-500 shadow-[0_0_15px_rgba(99,102,241,0.5)] transition-all duration-300" style={{ width: `${progress.value}%` }}></div>
                      </div>
                    </div>
                  )}

                  <div className="flex gap-5">
                    <button 
                      onClick={(e) => { e.stopPropagation(); if(videoRef.current) { videoRef.current.currentTime = selectedMoment?.start || 0; videoRef.current.play(); } }}
                      disabled={!selectedMoment || status === 'processing'} 
                      className="flex-1 bg-transparent border border-slate-800 hover:border-slate-700 py-5 rounded-3xl text-[10px] font-black uppercase tracking-[0.2em] transition-all disabled:opacity-20 active:scale-95 flex items-center justify-center gap-2"
                    >
                      <RefreshCw size={14} /> REPLAY CLIP
                    </button>
                    <button 
                      onClick={runExport}
                      disabled={!selectedMoment || status === 'processing' || !ffmpegLoaded}
                      className={`flex-1 py-5 rounded-3xl text-[10px] font-black uppercase tracking-[0.2em] shadow-2xl transition-all flex items-center justify-center gap-3 active:scale-95 ${
                        !ffmpegLoaded 
                          ? 'bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700 opacity-50' 
                          : 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-indigo-600/30'
                      }`}
                    >
                      <Download size={18} />
                      {!ffmpegLoaded ? 'WASM LOADING...' : 'EXPORT VERTICAL MP4'}
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>

      <footer className="max-w-7xl mx-auto mt-24 pb-20 border-t border-slate-900/50 pt-16 flex justify-between opacity-10 text-[9px] font-black uppercase tracking-[0.5em] text-slate-500">
        <p>© CLIPPER.PRO // LOCAL WORKER 4.8</p>
        <div className="flex gap-12 font-bold italic uppercase tracking-widest">
          <span>Encrypted</span>
          <span>Zero Server Storage</span>
          <span>WASM Driven</span>
        </div>
      </footer>
    </div>
  );
}